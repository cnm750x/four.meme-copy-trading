# ── BSC 节点 ────────────────────────────────────
# WebSocket 节点（必填）
WS_URL=wss://bsc-rpc.publicnode.com

# HTTP RPC 节点（必填）
BSC_RPC_URL=https://bsc-dataseed1.binance.org

# ── 监控目标 ─────────────────────────────────────
# 要监控的钱包地址，逗号分隔；留空则监控所有钱包（流量极大，慎用）
TARGET_WALLETS=0xWalletAddress1,0xWalletAddress2

# ── 合约地址 ─────────────────────────────────────
FOUR_MEME_ADDRESS=0x5c952063c7fc8610FFDB798152D69F0B9550762b
PANCAKE_SWAP_FACTORY_ADDR=0xCA143Ce32Fe78f1f7019d7d551a6402fC5350c73

# ── 功能开关 ─────────────────────────────────────
ENABLE_FOURMEME=true
ENABLE_PANCAKESWAP=true

# ── Web 服务 ─────────────────────────────────────
# 前端页面端口
WEB_PORT=3000

# ── 日志级别 ─────────────────────────────────────
LOG_LEVEL=info
